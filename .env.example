# ============================================================
#  ITTI LMS — Environment configuration
#  Copy this file to ".env" and fill in real values on the server.
# ============================================================

APP_NAME="IT Training Institute and College"
APP_SHORT="ITTI"
APP_ENV=production            # local | production
APP_DEBUG=false               # true on local, false on production
APP_URL=https://ittimaidan.com
ADMIN_URL=https://app.ittimaidan.com
APP_KEY=                      # 32+ random chars, used for tokens/encryption

# --- Database ---
# On Hostinger use mysql. Locally we use sqlite (no server needed).
DB_DRIVER=mysql               # mysql | sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=itti_lms
DB_USER=itti_user
DB_PASS=
# Used only when DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database/itti.sqlite

# --- Mail (Hostinger SMTP) ---
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=no-reply@ittimaidan.com
MAIL_PASS=
MAIL_FROM="IT Training Institute"
MAIL_ENCRYPTION=ssl

# --- Institute / contact details (shown on the site) ---
INSTITUTE_NAME="IT Training Institute and College, Kumber Maidan"
INSTITUTE_PHONE="+92 305 8382085"
WHATSAPP_NUMBER=923058382085
INSTITUTE_EMAIL=info@ittimaidan.com
FACEBOOK_URL=https://www.facebook.com/share/17wMmKSqSf/
YOUTUBE_PLAYLIST=https://youtube.com/playlist?list=PLOh6YaRDYnhxc0nlxjgUcwTMti2jm-95U
GOOGLE_MAP_URL=https://share.google/VhMvY3jczvZnEouCq

# --- Payment instructions (shown to students on the receipt-upload page) ---
PAY_BANK_NAME="Bank / JazzCash / Easypaisa"
PAY_ACCOUNT_TITLE="IT Training Institute"
PAY_ACCOUNT_NUMBER="0000-0000000-0"
PAY_INSTRUCTIONS="Send the course fee to the account above, then upload your receipt below. Your access is unlocked after we verify the payment."
